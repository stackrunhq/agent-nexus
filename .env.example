# Generate two DIFFERENT random tokens, each at least 32 characters. No default credentials.
NEXUS_ADMIN_TOKEN=
NEXUS_CLIENT_TOKEN=
# bootstrap: legacy development token; tenant: only per-tenant credentials accepted.
NEXUS_AUTH_MODE=bootstrap
# Add exact approved provider hostnames (without protocol or port).
NEXUS_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal
NEXUS_DATABASE_PATH=data/nexus.db
NEXUS_PROVIDER_CLOUD_KEY=
